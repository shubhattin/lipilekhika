<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Lipi Lekhika</string>
  <key>CFBundleDisplayName</key>
  <string>Lipi Lekhika</string>
  <!-- never change it: macOS keeps the Accessibility permission and the app's settings under it -->
  <key>CFBundleIdentifier</key>
  <string>in.lipilekhika.app</string>
  <key>CFBundleExecutable</key>
  <string>lipilekhika</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <!-- the build: the release workflow's run number, to tell test builds of one version apart -->
  <key>CFBundleVersion</key>
  <string>@BUILD@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- one running app: a second start would add a second keyboard hook -->
  <key>LSMultipleInstancesProhibited</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (C) 2026 Shubham Anand Gupta</string>
</dict>
</plist>
