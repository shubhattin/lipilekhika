{
  "name": "lipilekhika",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lipilekhika.in",
  "description": "A transliteration library for Indian Brahmic scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhattin/lipilekhika.git"
  },
  "keywords": [
    "indic-scripts",
    "transliteration",
    "typing"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/lipilekhika.umd.js",
  "jsdelivr": "./dist/lipilekhika.umd.js",
  "browser": "./dist/lipilekhika.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/esm/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/cjs/node.cjs"
      }
    },
    "./typing": {
      "import": {
        "types": "./dist/typing.d.ts",
        "default": "./dist/esm/typing.mjs"
      },
      "require": {
        "types": "./dist/typing.d.cts",
        "default": "./dist/cjs/typing.cjs"
      }
    },
    "./wasm": {
      "workerd": {
        "types": "./dist/wasm.d.ts",
        "default": "./dist/esm/wasm.workerd.mjs"
      },
      "edge-light": {
        "types": "./dist/wasm.d.ts",
        "default": "./dist/esm/wasm.edge-light.mjs"
      },
      "browser": {
        "import": {
          "types": "./dist/wasm.d.ts",
          "default": "./dist/esm/wasm.browser.mjs"
        },
        "require": {
          "types": "./dist/wasm.d.cts",
          "default": "./dist/cjs/wasm.cjs"
        }
      },
      "import": {
        "types": "./dist/wasm.d.ts",
        "default": "./dist/esm/wasm.mjs"
      },
      "require": {
        "types": "./dist/wasm.d.cts",
        "default": "./dist/cjs/wasm.cjs"
      }
    },
    "./wasm/slim": {
      "import": {
        "types": "./dist/wasm_slim.d.ts",
        "default": "./dist/esm/wasm_slim.mjs"
      },
      "require": {
        "types": "./dist/wasm_slim.d.cts",
        "default": "./dist/cjs/wasm_slim.cjs"
      }
    },
    "./lipilekhika.wasm": {
      "types": "./dist/lipilekhika.wasm.d.ts",
      "default": "./dist/lipilekhika.wasm"
    },
    "./lipilekhika.wasm?module": {
      "types": "./dist/lipilekhika.wasm.d.ts",
      "default": "./dist/lipilekhika.wasm?module"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "build:lib": "vite build --logLevel warn",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:bun": "bun test --concurrent --only-failures",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "lint": "oxlint",
    "publish:cli": "bun run build && npm publish",
    "bench": "bun run build:lib && node scripts/benchmark.mjs",
    "bench:bun": "bun run build:lib && bun scripts/benchmark.mjs",
    "bench:suite": "bun run build:lib && node scripts/bench_suite.mjs",
    "bench:suite:bun": "bun run build:lib && bun scripts/bench_suite.mjs",
    "test:runtime": "vite-node scripts/runtime_check.mjs && bun scripts/runtime_check.mjs",
    "test:runtime:dist": "node scripts/runtime_check.mjs --dist && bun scripts/runtime_check.mjs --dist",
    "test:workerd": "node scripts/workerd_check.mjs",
    "test:package": "node scripts/package_check.mjs",
    "complexity": "bun run build:lib && node scripts/complexity.mjs"
  },
  "devDependencies": {
    "@lipilekhika/script-data": "workspace:*",
    "@microsoft/api-extractor": "^7.58.6",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "mitata": "1.0.34",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "unplugin-macros": "^0.18.7",
    "vite": "^8",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
