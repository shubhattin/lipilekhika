{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": ["node_modules/**", "output/**"],
  "rules": {},
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/ban-ts-comment": "off"
      }
    }
  ]
}
