---
import RootLayout from '$components/RootLayout.astro';
import HomePageTyping from '$components/examples/HomePageTyping.svelte';
import Features from '$components/landing/Features.astro';
import PackagesAndIntegrations from '$components/landing/PackagesAndIntegrations.svelte';
import ScriptTrans from '$components/landing/ScriptTrans.svelte';
import { Globe, ArrowRight, Download } from 'lucide-svelte';
import { Icon } from 'svelte-icons-pack';
import { SiAndroid, SiApple, SiLinux, SiWindows } from 'svelte-icons-pack/si';

/** Platforms shown on the Download button (same colours as the /download page) */
const PLATFORM_ICONS = [
  { icon: SiWindows, className: 'fill-sky-600 dark:fill-sky-400' },
  { icon: SiApple, className: 'fill-foreground/80' },
  { icon: SiLinux, className: 'fill-foreground/80' },
  { icon: SiAndroid, className: 'fill-emerald-600 dark:fill-emerald-400' }
];

/** [English name, native name] for the Supported Scripts banner */
const SUPPORTED_SCRIPTS = [
  ['Devanagari', 'देवनागरी'],
  ['Telugu', 'తెలుగు'],
  ['Bengali', 'বাংলা'],
  ['Tamil', 'தமிழ்'],
  ['Kannada', 'ಕನ್ನಡ'],
  ['Gujarati', 'ગુજરાતી'],
  ['Malayalam', 'മലയാളം'],
  ['Gurmukhi', 'ਗੁਰਮੁਖੀ'],
  ['Odia', 'ଓଡ଼ିଆ'],
  ['Sinhala', 'සිංහල']
] as const;
---

<RootLayout
  title="Lipi Lekhika - Indian Script Transliteration"
  description="A powerful, fast, and open-source transliteration tool for Indian Brahmic Scripts. Type and convert between Devanagari, Telugu, Tamil, Bengali, and more."
>
  <!-- Hero Section -->
  <section
    class="relative flex flex-col items-center justify-center overflow-hidden px-4 pt-24 sm:pt-28 xl:pt-32"
  >
    <!-- Background gradient effects -->
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(59,130,246,0.15),transparent)]"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -z-10 size-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl"
    >
    </div>

    <div class="mx-auto w-full max-w-6xl px-0 sm:px-6">
      <div class="grid w-full items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <!-- Copy / CTAs -->
        <div class="text-center lg:text-left">
          <p
            class="mx-auto inline-flex items-center rounded-full border border-border/60 bg-linear-to-r from-white/90 via-slate-50/90 to-white/90 px-3 py-1 text-xs font-medium text-muted-foreground shadow-sm shadow-slate-200/80 backdrop-blur-sm lg:mx-0 dark:bg-background/40 dark:bg-none dark:shadow-none"
          >
            Lipi Lekhika • Realtime Typing + Transliteration
          </p>

          <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl lg:text-5xl">
            Type &amp; Convert{' '}
            <span
              class="bg-linear-to-r from-amber-500 via-orange-500 to-rose-500 bg-clip-text text-transparent dark:from-amber-300 dark:via-orange-400 dark:to-rose-400"
              >Indian scripts</span
            >{' '}
            with full speed and accuracy.
          </h1>

          <p class="mx-auto mt-4 max-w-2xl text-base text-muted-foreground sm:text-lg lg:mx-0">
            Built for modern and ancient Brahmic scripts — including Vedic accents — with a fast,
            predictable typing experience.
          </p>

          <div
            class="mx-auto mt-7 flex w-full max-w-sm flex-row flex-wrap items-center justify-center gap-2 sm:max-w-none lg:mx-0 lg:justify-start"
          >
            <a
              href="/app"
              class="group relative inline-flex h-11 grow items-center justify-center gap-1.5 rounded-lg border border-amber-500 bg-linear-to-b from-amber-400 to-amber-500 px-3 text-sm font-semibold whitespace-nowrap text-amber-950 shadow-[0_6px_20px_rgba(245,158,11,0.25)] transition-all hover:-translate-y-0.5 hover:from-amber-300 hover:to-amber-400 hover:shadow-[0_10px_28px_rgba(245,158,11,0.35)] active:translate-y-0 sm:flex-none sm:gap-2 sm:px-4"
            >
              <Globe class="size-4" />
              <span>Use Online</span>
              <ArrowRight
                class="hidden size-4 transition-transform group-hover:translate-x-1 sm:inline-block"
              />
            </a>

            <a
              href="/download"
              aria-label="Download for Windows, macOS, Linux and Android"
              class="group inline-flex h-11 grow items-center justify-center gap-1.5 rounded-lg border border-border bg-background/70 px-3 text-sm font-medium whitespace-nowrap text-foreground shadow-sm backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-accent/40 hover:shadow-md active:translate-y-0 sm:flex-none sm:gap-2.5 sm:px-4 dark:bg-card/60 dark:hover:bg-card"
            >
              <Download class="size-3.5 sm:size-4" />
              <span>Download</span>
              <span class="h-4 w-px bg-border" aria-hidden="true"></span>
              <span class="flex items-center gap-1 sm:gap-2" aria-hidden="true">
                {
                  PLATFORM_ICONS.map(({ icon, className }) => (
                    <Icon src={icon} className={`size-3.5 sm:size-4 ${className}`} />
                  ))
                }
              </span>
            </a>
          </div>
        </div>

        <!-- Try it out -->
        <div class="mx-auto w-full max-w-xl lg:mx-0 lg:justify-self-end">
          <div
            id="try"
            class="relative scroll-mt-24 rounded-2xl border border-slate-200 bg-white/90 p-4 shadow-2xl shadow-slate-900/10 backdrop-blur-sm sm:p-5 dark:border-border/60 dark:bg-card/70 dark:shadow-black/30"
          >
            <HomePageTyping client:load />
          </div>
        </div>
      </div>
    </div>
    <section class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
      <div class="flex justify-center">
        <div class="w-full max-w-xl text-center">
          <ScriptTrans client:load />
        </div>
      </div>
    </section>
  </section>

  <!-- Supported Scripts Banner -->
  <section
    class="border-y border-border/40 bg-linear-to-b from-muted/40 via-background to-background py-8 pt-4"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="mb-4 text-center text-sm font-medium text-muted-foreground">Supported Scripts</p>
      <div class="flex flex-wrap justify-center gap-3 text-lg sm:text-xl">
        {
          SUPPORTED_SCRIPTS.map(([name, native]) => (
            <span
              title={name}
              class="rounded-full border border-border/60 bg-linear-to-b from-white/90 to-slate-50/80 px-3 py-1 shadow-sm shadow-slate-200/80 dark:rounded-md dark:bg-background/50 dark:bg-none dark:shadow-none"
            >
              {native}
            </span>
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-muted-foreground">
        + Ancient scripts: Brahmi, Grantha, Modi, Sharada, Siddham<br />
        + Standard schemes: IAST, ITRANS, Harvard-Kyoto, SLP1
      </p>
    </div>
  </section>

  <!-- Features Section -->
  <Features />

  <PackagesAndIntegrations client:visible />
</RootLayout>
